newchanges.md

# tests/benchmarks/: same story as cells/ below -- track the small, public-
# domain ISCAS85/89 RTL sources (*.v, ~1.8MB total; these are standard
# academic benchmark circuits, e.g. tests/benchmarks/iscas85/c17.v is 529
# bytes), exclude the generated Yosys synthesis output (synth_sky130/,
# synth/ subdirectories, ~7.4MB, PDK/synth-version-specific derived
# artifacts -- same category as build/, regenerated by the Nix packaging's
# benchmark-regeneration step rather than committed).
tests/benchmarks/**/synth_sky130/
tests/benchmarks/**/synth/
# config.ofs.example: this rule is a no-op in practice -- the file is
# already git-tracked (same "gitignore doesn't retroactively untrack"
# story as cells/**/*.json below) and tests/python + the Nix packaging's
# python-tests check both read it directly.
config.ofs.example
misc/
# cells/: track the small, faultflow-authored JSON cell maps (+ osu035.yml
# config); exclude the large third-party PDK-derived Liberty/behavioral-model
# files. git history shows cells/ used to be tracked (e.g. "feat(cells): add
# sky130 adders..."), so this looks like a later blanket rule that
# collaterally swept up the JSON along with the big PDK files rather than a
# deliberate exclusion of the JSON itself.
#
# Two exceptions, both small and both actually needed (Yosys dfflibmap/abc
# during synthesis) rather than large unused corners:
#   sky130_fd_sc_hd__tt_025C_1v80.lib (13MB) -- the only Sky130 corner ever
#     referenced anywhere in this repo (config.ofs.example, bench_iscas85.sh,
#     bench_iscas89.sh, the Nix packaging's benchmark-regeneration steps).
#     The other two corners on disk (*_ff_n40C_1v95.lib, *_ss_n40C_1v40.lib,
#     81MB combined) are genuinely unused and stay excluded. Upstream's raw
#     form (google/skywater-pdk-libs-sky130_fd_sc_hd) ships a different,
#     SkyWater-internal per-cell JSON characterization format, not a
#     plain-text Liberty file Yosys can consume directly, and converting it
#     would risk producing something subtly different from what's already
#     proven working here -- so this tracks the known-good artifact
#     directly rather than reconstructing an equivalent from a different
#     upstream shape.
#   osu035_stdcells.lib (266KB) -- needed by tests/python/wrap/
#     test_wbr_atpg.py (tests/benchmarks/iscas85/synth/c17.json, the
#     OSU035-mapped corpus, distinct from synth_sky130/).
cells/**/*.lib
!cells/sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
!cells/osu/osu035_stdcells.lib
# sky130_fd_sc_hd.v (2.3MB, "Copyright 2020 The SkyWater PDK Authors,
# Licensed under the Apache License, Version 2.0" -- explicit, unambiguous)
# is tracked: needed by tests/python/sim/test_verify_gate.py's iverilog-
# based gate-level verification tests. osu035_stdcells.v is NOT tracked --
# confirmed unreferenced by any test (`grep -rl osu035_stdcells.v tests/
# python/` is empty), and its licensing is less clear (no header) than
# SkyWater's explicit Apache-2.0, so it stays excluded until something
# actually needs it.
cells/**/*.v
!cells/sky130/sky130_fd_sc_hd.v
parser.out
parsetab.py
config.ofs.example*

docs/plans
docs/superpowers
docs/integration

presentation/

# Benchmark run logs (local only)
bench_iscas85*.log
bench_iscas89*.log

# Design-specific scripts and examples (not part of the generic tool)
scripts/retarget_picorv32a.py
scripts/run_picorv32a_intest_extest.py
scripts/wrap_picorv32a.py
examples/picorv32_synth/
