    family-names: Nadeem
    email: rana.umar.nadeem21@gmail.com
    orcid: "https://orcid.org/0009-0008-9880-0116"
version: 0.1.0
license: Apache-2.0
repository-code: "https://github.com/ranaumarnadeem/faultflow"
url: "https://ranaumarnadeem.github.io/faultflow/"
keywords:
  - ATPG
  - automatic test pattern generation
  - fault simulation
  - design for test
  - DFT
  - stuck-at fault
  - transition fault
  - scan insertion
  - SAT solver
  - Yosys
  - sky130
  - open-source EDA
