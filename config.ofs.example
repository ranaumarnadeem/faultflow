# config.ofs.example
# Native SAT ATPG is the default sim path when [atpg] tool = native.
# --ext foo.test requires a same-stem foo.bench sidecar for PI order.
# --clean removes output/<top>/.faultflow/ internal workspace only;
# deliverables (coverage.rpt, patterns.test, scan artifacts) stay in output/<top>/.
# --purge deletes transient junk inside .faultflow/.

# Sky130 HD is the default PDK. ISCAS benchmark JSON is under tests/benchmarks/*/synth_sky130
# (Sky130) and tests/benchmarks/*/synth (OSU035, secondary). Match cell_lib to the netlist.

[design]
netlist   = tests/benchmarks/iscas85/synth_sky130/c17.json
top       = c17
cell_lib  = cells/sky130/sky130_fd_sc_hd.json
liberty   = cells/sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
yosys_ver = 0.61+129

[fault_model]
# model = stuck_at | transition  (`type` is accepted as a back-compat alias).
# transition is two-pattern (STR/STF) ATPG: combinational broadside plus scan LOC/LOS.
# It requires collapsing = false.
model                = stuck_at
# launch = loc | los  (launch-on-capture, or launch-on-shift for the scan flow).
launch               = loc
# Defaults to true (collapsing on) when this key is omitted entirely — explicitly
# disabled below, which is what every shipped example config does.
collapsing           = false
include_clock_faults = false
include_reset_faults = false

[simulation]
unsupported_cells = fail
verify            = false
verify_tool       = iverilog
verilog_models    = cells/sky130/sky130_fd_sc_hd.v
# Threads for parallel fault grading (the dominant ATPG cost).
#   1 = serial (default)   0 = auto (logical CPUs - 2, min 1)   N = N threads
# Coverage is bit-identical for any value; only wall-clock changes.
sim_threads       = 1

[atpg]
tool               = native
mode               = comb
output             = patterns.test
random_vectors       = 64
# Stop the random-fill phase and switch straight to SAT once fault coverage reaches
# this percent, or once the full random_vectors budget is graded, whichever comes
# first (default 85.0). 0.0 disables the early switch.
random_stop_coverage = 85.0
sat_conflict_limit   = 100000
max_rounds           = 20
sat_timeout_seconds  = 10
# Escalating per-fault SAT timeout (default: 2,10,60). Comma list smallest-first:
# each fault is attempted at the shortest timeout first and only escalates when it
# times out, so easy faults clear fast and long budgets go to the hard ones.
# Set to empty to use the fixed sat_timeout_seconds for all faults.
sat_timeout_schedule = 2,10,60
# Test-set compaction after ATPG: reverse (reverse-order fault-sim static
# compaction, coverage-preserving; default), dynamic (sim-verified cube-packing),
# or none.
compaction           = reverse
# Packing orders tried during dynamic compaction (default 1; compaction=dynamic only).
pack_orders          = 1
# Order faults by ascending structural cone size so the quickest SAT calls run
# first, detecting more faults incidentally early. Coverage-identical. Default on.
# Set to false to keep enumeration order. Stuck-at only.
order_by_cone_size   = true
# Restrict each fault's CNF to its structural cone of influence (default true).
cone_restrict        = true
# Incremental-SAT (IFC) solving, one observable cone at a time (default false).
incremental_sat      = false
# Fault-simulate an accepted SAT vector against ALL remaining faults, not just the
# target fault, so incidental "fallout" detections are dropped too (default true).
fault_drop_sat       = true
# Parallel SAT workers (default 1 = serial). N>1 forks N worker processes that
# each run one C++ solver call; the coordinator owns all DB writes. Requires a
# fork-capable OS (Linux/WSL); silently falls back to serial on Windows/spawn.
# Also settable interactively in the shell: WORKERS 10
workers              = 1
# Run OT structural reconvergence analysis before ATPG (default true).
# Requires the opentest binary on PATH. Falls back silently when unavailable.
# Phase A: reconvergent-site faults are sorted last and skip the short timeout
#   tier (they are likely hard/near-redundant).
# Phase B: faults at canceling-path stems are pre-certified UNSAT (no SAT call).
# Set to false to disable and reproduce the baseline ordering/timing behaviour.
preflight            = true
# PDK tech tag passed to opentest _preflight (default: auto-detect from cell_lib
# path — sky130 unless the path contains "osu035" or "osu").
preflight_tech       =
# Easy/hard worker split (default 2; only applies when workers >= 4).
# Each parallel submission wave reserves this many slots for easy faults
# (small-cone / non-reconvergent, front of the sorted list) while the
# remaining workers-easy_fault_reserve slots run hard faults (large-cone /
# reconvergent, back of the sorted list). This keeps fast and slow faults
# running concurrently: easy slots cycle in ~2 s while hard slots exhaust
# their full SAT budget. Set to 0 to disable (one flat queue).
easy_fault_reserve   = 2

[report]
output    = coverage.rpt
threshold = 95.0

[scan]
chains           = 1
max_chain_length =
scan_in          = scan_in
scan_out         = scan_out
scan_enable      = scan_en
run_techmap      = true
