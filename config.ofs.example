# config.ofs.example
# Native SAT ATPG is the default sim path when [atpg] tool = native.
# --ext foo.test requires a same-stem foo.bench sidecar for PI order.
# --clean removes output/<top>/.faultflow/ internal workspace only;
# deliverables (coverage.rpt, patterns.test, scan artifacts) stay in output/<top>/.
# --purge deletes transient junk inside .faultflow/.

# ISCAS benchmark synth JSON under tests/benchmarks/*/synth is OSU035-mapped.
# Use Sky130 cell_lib for Sky130-synthesized netlists (see examples/serial_adder_sky130.ofs).

[design]
netlist   = tests/benchmarks/iscas85/synth/c17.json
top       = c17
cell_lib  = cells/osu/osu035.json
liberty   = cells/osu/osu035_stdcells.lib
yosys_ver = 0.61+129

[fault_model]
# model = stuck_at | transition  (`type` is accepted as a back-compat alias).
# transition is combinational broadside two-pattern (STR/STF) ATPG; it requires
# collapsing = false and is incompatible with scan in this release (Step 2b).
model                = stuck_at
# launch = loc  (launch-on-capture; launch-on-shift is reserved, not implemented).
launch               = loc
collapsing           = false
include_clock_faults = false
include_reset_faults = false

[simulation]
unsupported_cells = fail
verify            = false
verify_tool       = iverilog
verilog_models    = cells/osu/osu035_stdcells.v
tp_file           =

[atpg]
tool               = native
mode               = comb
output             = patterns.test
random_vectors       = 64
sat_conflict_limit   = 100000
max_rounds           = 20
sat_timeout_seconds  = 10
# Test-set compaction after ATPG: reverse (reverse-order fault-sim static
# compaction, coverage-preserving; default) or none.
compaction           = reverse

[report]
output    = coverage.rpt
threshold = 95.0
verbose   = true

[scan]
chains           = 1
max_chain_length =
scan_in          = scan_in
scan_out         = scan_out
scan_enable      = scan_en
run_techmap      = true

[debug]
level = INFO
