# config.ofs.example

[design]
netlist   = design.json
top       = c17
cell_lib  = cells/osu/osu035.json
liberty   = cells/osu/osu035_stdcells.lib
verilog_models = cells/osu/osu035_stdcells.v
yosys_ver = 0.61+129

[fault_model]
type                 = stuck_at
collapsing           = false
include_clock_faults = false
include_reset_faults = false

[simulation]
unsupported_cells = fail
verify            = false
verify_tool       = iverilog
tp_file           =

[atpg]
tool   = quaigh
mode   = comb
blif   = design.blif
output = vectors.yml

[report]
output    = coverage_report.json
threshold = 95.0
verbose   = true

[debug]
level = INFO
