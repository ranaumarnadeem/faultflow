# config.ofs.example
# Native SAT ATPG is the default sim path when [atpg] tool = native.
# --ext foo.test requires a same-stem foo.bench sidecar for PI order.
# --clean removes output/<top>/.faultflow/ internal workspace only;
# deliverables (coverage.rpt, patterns.test, scan artifacts) stay in output/<top>/.
# --purge deletes transient junk inside .faultflow/.

# ISCAS benchmark synth JSON under tests/benchmarks/*/synth is OSU035-mapped.
# Use Sky130 cell_lib for Sky130-synthesized netlists (see examples/serial_adder_sky130.ofs).

[design]
netlist   = tests/benchmarks/iscas85/synth/c17.json
top       = c17
cell_lib  = cells/osu/osu035.json
liberty   = cells/osu/osu035_stdcells.lib
yosys_ver = 0.61+129

[fault_model]
# model = stuck_at | transition  (`type` is accepted as a back-compat alias).
# transition is combinational broadside two-pattern (STR/STF) ATPG; it requires
# collapsing = false and is incompatible with scan in this release (Step 2b).
model                = stuck_at
# launch = loc  (launch-on-capture; launch-on-shift is reserved, not implemented).
launch               = loc
collapsing           = false
include_clock_faults = false
include_reset_faults = false

[simulation]
unsupported_cells = fail
verify            = false
verify_tool       = iverilog
verilog_models    = cells/osu/osu035_stdcells.v
tp_file           =

[atpg]
tool               = native
mode               = comb
output             = patterns.test
random_vectors       = 64
sat_conflict_limit   = 100000
max_rounds           = 20
sat_timeout_seconds  = 10
# Escalating per-fault SAT timeout. Empty (default) keeps the single fixed
# sat_timeout_seconds. A comma list smallest-first like "2,10,60" attempts each
# fault at the short timeout first and only gives a fault more time once it has
# timed out, so easy faults clear fast and long budgets go to the hard ones.
sat_timeout_schedule =
# Test-set compaction after ATPG: reverse (reverse-order fault-sim static
# compaction, coverage-preserving; default) or none.
compaction           = reverse
# Order faults by ascending structural cone size (smallest first) so the quickest
# SAT calls run first and detect more faults incidentally early. Coverage is
# identical either way; false (default) keeps enumeration order. Stuck-at only.
order_by_cone_size   = false
# Parallel SAT workers. 1 (default) = serial; N>1 = fork N worker processes that
# each run one C++ solver call and return the result to the coordinator.  The
# coordinator owns all DB writes (workers are pure compute).  Requires a fork-
# capable OS (Linux/WSL); silently falls back to serial on Windows/spawn.
workers              = 1

[report]
output    = coverage.rpt
threshold = 95.0
verbose   = true

[scan]
chains           = 1
max_chain_length =
scan_in          = scan_in
scan_out         = scan_out
scan_enable      = scan_en
run_techmap      = true

[debug]
level = INFO
