{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faultflow.local/schemas/cell_map.schema.json",
  "title": "faultflow runtime cell map",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["node_type"],
    "properties": {
      "node_type": {"enum": ["GATE", "FF", "LATCH", "CONST", "TBUF", "ICG"]},
      "gate_type": {"type": "string"},
      "inputs": {"type": "array", "items": {"type": "string"}},
      "outputs": {"type": "object"},
      "ff": {
        "type": "object",
        "properties": {
          "trigger": {"enum": ["POSEDGE", "NEGEDGE"]},
          "clock": {"type": "string"},
          "data": {"type": "string"},
          "output": {"type": "string"},
          "scan": {
            "type": "object",
            "properties": {
              "in": {"type": "string"},
              "enable": {"type": "string"}
            }
          }
        }
      },
      "status": {"type": "string"},
      "reason": {"type": "string"}
    }
  }
}
