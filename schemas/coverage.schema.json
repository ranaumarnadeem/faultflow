{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faultflow coverage report",
  "type": "object",
  "required": ["metadata", "policy", "summary", "run", "per_node", "undetected_faults"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "top",
        "generated_at",
        "faultflow_version",
        "yosys_version",
        "netlist_hash",
        "cell_lib_hash",
        "config_hash",
        "template_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "top": { "type": "string" },
        "generated_at": { "type": "string" },
        "faultflow_version": { "type": "string" },
        "yosys_version": { "type": "string" },
        "netlist_hash": { "type": "string" },
        "cell_lib_hash": { "type": "string" },
        "config_hash": { "type": "string" },
        "template_hash": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "unsupported_cells",
        "include_clock_faults",
        "include_reset_faults",
        "collapsing"
      ],
      "additionalProperties": false,
      "properties": {
        "unsupported_cells": { "enum": ["fail", "blackbox"] },
        "include_clock_faults": { "type": "boolean" },
        "include_reset_faults": { "type": "boolean" },
        "collapsing": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_raw_faults",
        "denominator",
        "detected",
        "undetected",
        "redundant",
        "collapsed",
        "excluded_blackbox",
        "excluded_clock",
        "excluded_reset",
        "coverage_percent"
      ],
      "additionalProperties": false,
      "properties": {
        "total_raw_faults": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "detected": { "type": "integer", "minimum": 0 },
        "undetected": { "type": "integer", "minimum": 0 },
        "redundant": { "type": "integer", "minimum": 0 },
        "collapsed": { "type": "integer", "minimum": 0 },
        "excluded_blackbox": { "type": "integer", "minimum": 0 },
        "excluded_clock": { "type": "integer", "minimum": 0 },
        "excluded_reset": { "type": "integer", "minimum": 0 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "vector_source",
        "vector_count",
        "atpg_generation_seconds",
        "fault_simulation_seconds",
        "total_sim_seconds"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "vector_source": { "type": ["string", "null"] },
        "vector_count": { "type": "integer", "minimum": 0 },
        "atpg_generation_seconds": { "type": "number", "minimum": 0 },
        "fault_simulation_seconds": { "type": "number", "minimum": 0 },
        "total_sim_seconds": { "type": "number", "minimum": 0 },
        "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "atpg_terminal_reason": {
          "type": ["string", "null"],
          "enum": ["COMPLETE", "THRESHOLD_MET", "STALLED", "MAX_ROUNDS", null]
        },
        "atpg_rounds": { "type": "integer", "minimum": 0 },
        "atpg_sat": { "type": "integer", "minimum": 0 },
        "atpg_unsat": { "type": "integer", "minimum": 0 },
        "atpg_timeout": { "type": "integer", "minimum": 0 },
        "atpg_unknown": { "type": "integer", "minimum": 0 },
        "atpg_rejected_candidates": { "type": "integer", "minimum": 0 },
        "atpg_generated_vectors": { "type": "integer", "minimum": 0 },
        "atpg_accepted_vectors": { "type": "integer", "minimum": 0 }
      }
    },
    "per_node": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "net_id",
          "net_name",
          "total_faults",
          "detected",
          "undetected",
          "collapsed",
          "excluded",
          "coverage_percent"
        ],
        "additionalProperties": false,
        "properties": {
          "net_id": { "type": "integer" },
          "net_name": { "type": "string" },
          "total_faults": { "type": "integer", "minimum": 0 },
          "detected": { "type": "integer", "minimum": 0 },
          "undetected": { "type": "integer", "minimum": 0 },
          "collapsed": { "type": "integer", "minimum": 0 },
          "excluded": { "type": "integer", "minimum": 0 },
          "coverage_percent": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 100 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "undetected_faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "net_id", "net_name", "fault_type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "net_id": { "type": "integer" },
          "net_name": { "type": "string" },
          "fault_type": { "enum": ["sa0", "sa1"] }
        }
      }
    }
  }
}
