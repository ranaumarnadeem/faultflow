{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faultflow coverage report",
  "type": "object",
  "required": ["metadata", "policy", "summary", "run", "per_node", "reason_summary", "undetected_faults"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "top",
        "generated_at",
        "faultflow_version",
        "yosys_version",
        "netlist_hash",
        "cell_lib_hash",
        "config_hash",
        "template_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "top": { "type": "string" },
        "generated_at": { "type": "string" },
        "faultflow_version": { "type": "string" },
        "yosys_version": { "type": "string" },
        "netlist_hash": { "type": "string" },
        "cell_lib_hash": { "type": "string" },
        "config_hash": { "type": "string" },
        "template_hash": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "unsupported_cells",
        "include_clock_faults",
        "include_reset_faults",
        "collapsing",
        "blackbox_instances",
        "blackbox_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "unsupported_cells": { "enum": ["fail", "blackbox"] },
        "include_clock_faults": { "type": "boolean" },
        "include_reset_faults": { "type": "boolean" },
        "collapsing": { "type": "boolean" },
        "blackbox_instances": { "type": "array", "items": { "type": "string" } },
        "blackbox_boundary": { "enum": ["none", "pseudo_port", "opaque"] },
        "blackbox_output_values": {
          "type": "object",
          "additionalProperties": { "enum": ["x", "0"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_raw_faults",
        "structural_eligible",
        "denominator",
        "detected",
        "undetected",
        "redundant",
        "collapsed",
        "excluded_blackbox",
        "excluded_clock",
        "excluded_reset",
        "excluded_scan",
        "excluded_scan_internal",
        "excluded_scan_chain",
        "excluded_cross_domain",
        "excluded_wbr_decoupled",
        "excluded_jtag",
        "excluded_wsp",
        "protocol_unresolved",
        "compression_unresolved",
        "compaction_unresolved",
        "blackbox_unresolved",
        "hold_unresolved",
        "fault_coverage_percent",
        "test_coverage_percent",
        "coverage_percent"
      ],
      "additionalProperties": false,
      "properties": {
        "total_raw_faults": { "type": "integer", "minimum": 0 },
        "structural_eligible": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "detected": { "type": "integer", "minimum": 0 },
        "undetected": { "type": "integer", "minimum": 0 },
        "redundant": { "type": "integer", "minimum": 0 },
        "collapsed": { "type": "integer", "minimum": 0 },
        "excluded_blackbox": { "type": "integer", "minimum": 0 },
        "excluded_clock": { "type": "integer", "minimum": 0 },
        "excluded_reset": { "type": "integer", "minimum": 0 },
        "excluded_scan": { "type": "integer", "minimum": 0 },
        "excluded_scan_internal": { "type": "integer", "minimum": 0 },
        "excluded_scan_chain": { "type": "integer", "minimum": 0 },
        "excluded_cross_domain": { "type": "integer", "minimum": 0 },
        "excluded_wbr_decoupled": { "type": "integer", "minimum": 0 },
        "excluded_jtag": { "type": "integer", "minimum": 0 },
        "excluded_wsp": { "type": "integer", "minimum": 0 },
        "protocol_unresolved": { "type": "integer", "minimum": 0 },
        "compression_unresolved": { "type": "integer", "minimum": 0 },
        "compaction_unresolved": { "type": "integer", "minimum": 0 },
        "blackbox_unresolved": { "type": "integer", "minimum": 0 },
        "hold_unresolved": { "type": "integer", "minimum": 0 },
        "fault_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "test_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "fault_model": { "enum": ["stuck_at", "transition"] }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "vector_source",
        "vector_count",
        "atpg_generation_seconds",
        "fault_simulation_seconds",
        "total_sim_seconds"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "vector_source": { "type": ["string", "null"] },
        "vector_count": { "type": "integer", "minimum": 0 },
        "atpg_generation_seconds": { "type": "number", "minimum": 0 },
        "fault_simulation_seconds": { "type": "number", "minimum": 0 },
        "total_sim_seconds": { "type": "number", "minimum": 0 },
        "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "atpg_terminal_reason": {
          "type": ["string", "null"],
          "enum": ["COMPLETE", "THRESHOLD_MET", "STALLED", "MAX_ROUNDS", "RANDOM_ONLY", null]
        },
        "atpg_rounds": { "type": "integer", "minimum": 0 },
        "atpg_sat": { "type": "integer", "minimum": 0 },
        "atpg_unsat": { "type": "integer", "minimum": 0 },
        "atpg_timeout": { "type": "integer", "minimum": 0 },
        "atpg_unknown": { "type": "integer", "minimum": 0 },
        "atpg_rejected_candidates": { "type": "integer", "minimum": 0 },
        "atpg_generated_vectors": { "type": "integer", "minimum": 0 },
        "atpg_accepted_vectors": { "type": "integer", "minimum": 0 }
      }
    },
    "per_node": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "net_id",
          "net_name",
          "total_faults",
          "detected",
          "undetected",
          "collapsed",
          "excluded",
          "coverage_percent"
        ],
        "additionalProperties": false,
        "properties": {
          "net_id": { "type": "integer" },
          "net_name": { "type": "string" },
          "total_faults": { "type": "integer", "minimum": 0 },
          "detected": { "type": "integer", "minimum": 0 },
          "undetected": { "type": "integer", "minimum": 0 },
          "collapsed": { "type": "integer", "minimum": 0 },
          "excluded": { "type": "integer", "minimum": 0 },
          "coverage_percent": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 100 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "reason_summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "undetected_faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "net_id", "net_name", "fault_type", "fault_site_key", "protocol_unresolved", "compression_unresolved", "compaction_unresolved", "blackbox_unresolved", "hold_unresolved", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "net_id": { "type": "integer" },
          "net_name": { "type": "string" },
          "fault_type": { "enum": ["sa0", "sa1", "str", "stf"] },
          "fault_site_key": { "type": "string" },
          "protocol_unresolved": { "type": "boolean" },
          "compression_unresolved": { "type": "boolean" },
          "compaction_unresolved": { "type": "boolean" },
          "blackbox_unresolved": { "type": "boolean" },
          "hold_unresolved": { "type": "boolean" },
          "reason": {
            "enum": [
              "structurally_unresolved",
              "compression_unresolved",
              "compaction_unresolved",
              "blackbox_unresolved",
              "hold_unresolved",
              "structurally_uncontrollable",
              "sat_hard",
              "sat_timeout",
              "solver_unknown",
              "never_attempted"
            ]
          },
          "sat_outcome": { "enum": ["timeout", "unknown"] },
          "bottleneck_net": { "type": "string" }
        }
      }
    },
    "autombist_categories": {
      "description": "Coverage by autoMBIST instance category ([autombist] manifest); faults no instance owns count as glue",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["detected", "denominator", "blackbox_unresolved", "hold_unresolved", "coverage_percent"],
        "additionalProperties": false,
        "properties": {
          "detected": { "type": "integer", "minimum": 0 },
          "denominator": { "type": "integer", "minimum": 0 },
          "blackbox_unresolved": { "type": "integer", "minimum": 0 },
          "hold_unresolved": { "type": "integer", "minimum": 0 },
          "coverage_percent": { "type": ["number", "null"] },
          "graded_by": {
            "description": "The category's faults by the test that grades them: scan ATPG (exclusion none), ff.py jtag (the faults scan leaves to it) and ff.py wsp",
            "type": "object",
            "required": ["scan", "jtag", "wsp"],
            "additionalProperties": false,
            "properties": {
              "scan": { "type": "integer", "minimum": 0 },
              "jtag": { "type": "integer", "minimum": 0 },
              "wsp": { "type": "integer", "minimum": 0 }
            }
          },
          "combined_detected": { "type": "integer", "minimum": 0 },
          "combined_denominator": { "type": "integer", "minimum": 0 },
          "combined_coverage_percent": { "type": ["number", "null"] }
        }
      }
    },
    "graded_by": {
      "description": "Which test grades which faults of a scan campaign: scan ATPG the core and the inserted logic that is ordinary logic; test instruments (a JTAG TAP, the IJTAG network, an IEEE 1500 WSP) by their own programs (ff.py jtag, ff.py wsp: the faults scan leaves to them); memories by MBIST. detected is null where that test has not run. combined: every population together, null until a test has run",
      "type": "object",
      "required": ["scan", "jtag", "wsp", "reset", "memories", "combined"],
      "additionalProperties": false,
      "properties": {
        "scan": {
          "type": "object",
          "required": ["faults", "detected"],
          "additionalProperties": false,
          "properties": {
            "faults": { "type": "integer", "minimum": 0 },
            "detected": { "type": "integer", "minimum": 0 }
          }
        },
        "jtag": { "$ref": "#/$defs/left_to_test" },
        "wsp": { "$ref": "#/$defs/left_to_test" },
        "reset": {
          "type": "object",
          "required": ["faults"],
          "additionalProperties": false,
          "properties": { "faults": { "type": "integer", "minimum": 0 } }
        },
        "memories": {
          "type": "object",
          "required": ["instances"],
          "additionalProperties": false,
          "properties": { "instances": { "type": "array", "items": { "type": "string" } } }
        },
        "combined": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["structural_eligible", "denominator", "detected", "redundant", "test_coverage_percent"],
              "additionalProperties": false,
              "properties": {
                "structural_eligible": { "type": "integer", "minimum": 0 },
                "denominator": { "type": "integer", "minimum": 0 },
                "detected": { "type": "integer", "minimum": 0 },
                "redundant": { "type": "integer", "minimum": 0 },
                "test_coverage_percent": { "type": ["number", "null"] }
              }
            }
          ]
        }
      }
    },
    "jtag": {
      "description": "The latest ff.py jtag grade of this campaign's faults: a TCK program played through the TAP and compared at TDO",
      "type": "object",
      "required": [
        "program_digest",
        "tck_periods",
        "tests",
        "graded",
        "reset_path_ungraded",
        "detected",
        "detected_by_test",
        "detected_only_by_jtag",
        "scan_redundant_conflicts",
        "holds"
      ],
      "additionalProperties": false,
      "properties": {
        "program_digest": { "type": "string" },
        "tck_periods": { "type": "integer", "minimum": 1 },
        "tests": { "type": "array", "items": { "type": "string" } },
        "graded": { "type": "integer", "minimum": 0 },
        "reset_path_ungraded": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "detected_by_test": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "detected_only_by_jtag": { "type": "integer", "minimum": 0 },
        "scan_redundant_conflicts": { "type": "array", "items": { "type": "string" } },
        "holds": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "combined": {
      "description": "Scan and JTAG credit together: detected by either; redundant only if scan proved it and JTAG did not detect it",
      "type": "object",
      "required": [
        "structural_eligible",
        "denominator",
        "detected",
        "redundant",
        "fault_coverage_percent",
        "test_coverage_percent"
      ],
      "additionalProperties": false,
      "properties": {
        "structural_eligible": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "redundant": { "type": "integer", "minimum": 0 },
        "fault_coverage_percent": { "type": ["number", "null"] },
        "test_coverage_percent": { "type": ["number", "null"] }
      }
    },
    "wsp": {
      "description": "The latest ff.py wsp grade of this campaign's faults: an IEEE 1500 WSP's integrity program, compared at WSO, of the faults the scan test left to it (excluded_wsp); combined: the scan's and its credit together",
      "type": "object",
      "required": [
        "program_digest",
        "cycles",
        "tests",
        "graded",
        "detected",
        "init_dependent",
        "detected_by_test",
        "combined"
      ],
      "additionalProperties": false,
      "properties": {
        "program_digest": { "type": "string" },
        "cycles": { "type": "integer", "minimum": 1 },
        "tests": { "type": "array", "items": { "type": "string" } },
        "graded": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "init_dependent": { "type": "integer", "minimum": 0 },
        "detected_by_test": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "combined": {
          "type": "object",
          "required": [
            "structural_eligible",
            "denominator",
            "detected",
            "redundant",
            "test_coverage_percent"
          ],
          "additionalProperties": false,
          "properties": {
            "structural_eligible": { "type": "integer", "minimum": 0 },
            "denominator": { "type": "integer", "minimum": 0 },
            "detected": { "type": "integer", "minimum": 0 },
            "redundant": { "type": "integer", "minimum": 0 },
            "test_coverage_percent": { "type": ["number", "null"] }
          }
        }
      }
    },
    "wrapper": {
      "description": "A wrapped block's -- or a SoC's -- test in a wrapper mode (faultflow.wrap.report), by part: its core, its boundary cells, its mode pins, and a SoC's glue. decoupled: left to the other mode (wbr_decoupled)",
      "type": "object",
      "required": ["mode", "cells", "parts"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["intest", "extest"] },
        "cells": { "type": "integer", "minimum": 1 },
        "parts": {
          "type": "object",
          "required": ["core", "boundary", "mode"],
          "additionalProperties": false,
          "properties": {
            "core": { "$ref": "#/$defs/wrapper_part" },
            "boundary": { "$ref": "#/$defs/wrapper_part" },
            "mode": { "$ref": "#/$defs/wrapper_part" },
            "glue": { "$ref": "#/$defs/wrapper_part" }
          }
        }
      }
    }
  },
  "$defs": {
    "left_to_test": {
      "description": "The faults scan leaves to a test instrument's own test, and what that test detected (null: not run)",
      "type": "object",
      "required": ["faults", "detected", "graded"],
      "additionalProperties": false,
      "properties": {
        "faults": { "type": "integer", "minimum": 0 },
        "detected": { "type": ["integer", "null"], "minimum": 0 },
        "graded": { "type": "boolean" }
      }
    },
    "wrapper_part": {
      "type": "object",
      "required": [
        "detected",
        "denominator",
        "decoupled",
        "blackbox_unresolved",
        "hold_unresolved",
        "coverage_percent"
      ],
      "additionalProperties": false,
      "properties": {
        "detected": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "decoupled": { "type": "integer", "minimum": 0 },
        "blackbox_unresolved": { "type": "integer", "minimum": 0 },
        "hold_unresolved": { "type": "integer", "minimum": 0 },
        "coverage_percent": { "type": ["number", "null"] }
      }
    }
  }
}
