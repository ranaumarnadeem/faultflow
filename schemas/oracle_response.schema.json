{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "faultflow oracle_response",
  "description": "Flat response written by faultflow for OT's atpg-loop oracle protocol.",
  "type": "object",
  "required": [
    "backend",
    "coverage_percent",
    "fault_coverage_percent",
    "vector_count",
    "terminal_reason",
    "undetected_faults",
    "per_node"
  ],
  "additionalProperties": true,
  "properties": {
    "backend": {
      "type": "string",
      "const": "faultflow"
    },
    "coverage_percent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "fault_coverage_percent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "vector_count": {
      "type": "integer",
      "minimum": 0
    },
    "terminal_reason": {
      "type": "string",
      "enum": ["target_reached", "exhausted", "timeout"]
    },
    "undetected_faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "net_name", "fault_type"],
        "properties": {
          "id": {"type": "integer"},
          "net_name": {"type": "string"},
          "fault_type": {"type": "string"}
        }
      }
    },
    "per_node": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["net_id", "net_name"],
        "properties": {
          "net_id": {"type": "integer"},
          "net_name": {"type": "string"},
          "detected": {"type": "integer"},
          "undetected": {"type": "integer"}
        }
      }
    },
    "session_id": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    }
  }
}
