{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faultflow SoC (hierarchical project) chip coverage report",
  "type": "object",
  "required": ["schema", "project", "chip", "scopes", "guards"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "faultflow_soc_coverage_v1" },
    "project": { "type": "string" },
    "chip": {
      "type": "object",
      "required": ["denominator", "detected", "coverage_percent"],
      "additionalProperties": false,
      "properties": {
        "denominator": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "coverage_percent": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "top",
          "campaign_id",
          "denominator",
          "detected",
          "owned",
          "owned_detected",
          "foreign",
          "handoff",
          "excluded_by_design",
          "total_sites",
          "coverage_percent"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "top": { "type": "string" },
          "campaign_id": { "type": "integer" },
          "denominator": { "type": "integer", "minimum": 0 },
          "detected": { "type": "integer", "minimum": 0 },
          "owned": { "type": "integer", "minimum": 0 },
          "owned_detected": { "type": "integer", "minimum": 0 },
          "foreign": { "type": "integer", "minimum": 0 },
          "handoff": { "type": "integer", "minimum": 0 },
          "excluded_by_design": { "type": "integer", "minimum": 0 },
          "total_sites": { "type": "integer", "minimum": 0 },
          "coverage_percent": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 100 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tops_disjoint": { "type": "boolean" },
        "no_double_count": { "type": "boolean" },
        "partition_total": { "type": "boolean" },
        "handoff_complete": { "type": "boolean" },
        "owned_sites": { "type": "integer", "minimum": 0 },
        "handoff_sites": { "type": "integer", "minimum": 0 },
        "accounted_sites": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
