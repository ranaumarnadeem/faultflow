{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faultflow SoC (faultflow_project_v2) chip coverage report",
  "description": "faultflow.reporter.soc: the chip number over every block's INTEST and the SoC's EXTEST, each fault counted once (faultflow.project.soc_aggregate).",
  "type": "object",
  "required": ["schema", "project", "chip", "scopes", "guards"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "faultflow_soc_coverage_v2" },
    "project": { "type": "string" },
    "chip": {
      "type": "object",
      "required": ["denominator", "detected", "coverage_percent"],
      "additionalProperties": false,
      "properties": {
        "denominator": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "coverage_percent": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "campaign_id",
          "owned",
          "owned_detected",
          "handoff",
          "excluded",
          "total",
          "coverage_percent"
        ],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "campaign_id": { "type": "integer" },
          "owned": { "type": "integer", "minimum": 0 },
          "owned_detected": { "type": "integer", "minimum": 0 },
          "handoff": { "type": "integer", "minimum": 0 },
          "excluded": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "coverage_percent": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 100 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scopes_distinct": { "type": "boolean" },
        "no_fault_counted_twice": { "type": "boolean" },
        "handoffs_owned": { "type": "boolean" },
        "owned_identities": { "type": "integer", "minimum": 0 },
        "handed_identities": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
