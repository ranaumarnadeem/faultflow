        }
      },
      "netnames": {
        "A": { "hide_name": 0, "bits": [2, 8], "attributes": {} },
        "__ppi_ff0": { "hide_name": 0, "bits": [3], "attributes": {} },
        "__ppi_ff1": { "hide_name": 0, "bits": [4], "attributes": {} },
        "Y": { "hide_name": 0, "bits": [5], "attributes": {} },
        "__ppo_ff0": { "hide_name": 0, "bits": [6], "attributes": {} },
        "__ppo_ff1": { "hide_name": 0, "bits": [7], "attributes": {} },
